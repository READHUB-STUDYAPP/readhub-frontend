# ==============================================================================
# ReadHub Frontend (Vite) — Environment Variables
# Copy to `.env` and fill in real values.
# Only VITE_* vars are exposed to the browser bundle — never put secrets here.
# These are read at BUILD time, so rebuild after changing them.
# ==============================================================================

# --- Google OAuth ---
# OAuth 2.0 Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Cloudinary ---
# Public cloud name used to build direct upload URLs
VITE_CLOUDINARY_NAME=your_cloud_name

# --- API base URL ---
# Bare origin of the backend API — NO trailing slash and NO "/api" suffix.
# The code appends "/api/" where needed (apiEndpoints.js) and "/api/..." (api.js).
# Read at BUILD time -> rebuild the frontend after changing this.
VITE_API_BASE_URL=https://api.readhub.example.com
